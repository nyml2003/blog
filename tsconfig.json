{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "apps/playground/src",
    "apps/playground/test",
    "scripts"
  ]
}
