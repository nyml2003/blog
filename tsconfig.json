{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": [
    "css-modules.d.ts",
    "packages/*/*/src",
    "packages/*/*/test",
    "packages/app/pages/*/src",
    "packages/app/pages/*/test",
    "apps/blog/src",
    "apps/blog-deploy/src",
    "apps/playground/src",
    "apps/playground/test"
  ]
}
