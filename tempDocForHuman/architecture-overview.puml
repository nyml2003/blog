@startuml 博客系统总体架构
' ----------------------------------------------------------------------------
' 最简架构视图：只画进程、存储、外部系统与两条核心链路（阅读 / 内容生产）。
' 有意省略：开发期 Mock / Vite、ops CLI、鉴权与凭证、迁移、BFF 拆分等细节。
' ----------------------------------------------------------------------------

skinparam shadowing false
skinparam defaultFontName "Noto Sans CJK SC"
skinparam defaultTextAlignment center
skinparam defaultFontSize 14
skinparam roundCorner 8

skinparam rectangle {
  BackgroundColor<<ui>>      #FDF6EC
  BorderColor<<ui>>          #B8860B
  BackgroundColor<<process>> #E8F0FE
  BorderColor<<process>>     #4A6FA5
  BackgroundColor<<storage>> #F3EDF8
  BorderColor<<storage>>     #7B5EA7
  BackgroundColor<<external>> #F1F3EC
  BorderColor<<external>>    #6E7F5A
}
skinparam database {
  BackgroundColor<<storage>> #F3EDF8
  BorderColor<<storage>>     #7B5EA7
}
skinparam ArrowColor #555555

actor "读者" as reader
actor "作者（你）" as author

rectangle "公开页面\nDesktop / Mobile" as public_ui <<ui>>
rectangle "管理页面\nDesktop" as admin_ui <<ui>>

rectangle "**Product 服务** :8080\n——\n唯一面向浏览器的进程\n公开/管理 API · 数据拼装 · 鉴权" as product <<process>>

rectangle "**GitHub 内容仓库**\n——\n内容唯一真源\ntaxonomy.json + articles/<id>/" as github <<external>>

rectangle "**Data 服务** :8081\n——\n只被 Product 调用\n受控读写 · 不懂业务" as data <<process>>

database "SQLite\n公开快照 + 编辑工作区" as db <<storage>>

' ========== 阅读链路（随时发生） ==========
reader --> public_ui
public_ui --> product : 页面与 /api/public/*
product --> data : 受控操作（HTTP）
data --> db : 读公开快照

' ========== 内容生产链路（编号顺序） ==========
author --> admin_ui : ① 写作 / 改分类
admin_ui --> product : /api/admin/*
product --> github : ② 校验后提交 PR
author --> github : ③ 手动合入\n（服务器永不 merge）
github --> product : ④ 同步：拉取已合入内容
product --> data : ⑤ 单事务整体替换快照

note bottom of db
  <b>⑥ 公开端只读快照</b>
  未合入的内容永远不会泄漏
end note

footer 本图省略：开发期 Mock / Vite 开发服务器、ops CLI、鉴权与迁移细节（属下一层图）
@enduml
