{
  "name": "@fluvient-loom/serde-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["src", "README.md", "package.json"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
