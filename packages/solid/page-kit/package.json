{
  "name": "@fluvient-loom/page-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/shared.ts",
      "import": "./src/shared.ts"
    },
    "./mobile": {
      "types": "./src/mobile.tsx",
      "import": "./src/mobile.tsx"
    },
    "./desktop": {
      "types": "./src/desktop.tsx",
      "import": "./src/desktop.tsx"
    }
  },
  "files": ["src", "README.md", "package.json"],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "pnpm typecheck",
    "build": "pnpm typecheck",
    "smoke": "test -s src/mobile.tsx && test -s src/desktop.tsx"
  },
  "dependencies": {
    "@fluvient/core": "workspace:*",
    "@fluvient-loom/app-shell": "workspace:*",
    "@fluvient-loom/net": "workspace:*",
    "@fluvient-loom/port": "workspace:*",
    "@fluvient-loom/web": "workspace:*"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
