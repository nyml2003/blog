<view class="page theme-{{theme}} font-{{font}}"><view class="title">推荐</view><view class="muted" wx:if="{{state === 'loading'}}">加载中...</view><view class="error" wx:elif="{{state === 'error'}}">{{error}}<button bindtap="retry">重试</button></view><view class="muted" wx:elif="{{state === 'empty'}}">暂无文章</view><block wx:else><view wx:for="{{items}}" wx:key="id" class="item" data-id="{{item.id}}" bindtap="open"><view>{{item.title}}</view><view class="muted">{{item.summary}}</view></view></block></view><view class="nav"><button bindtap="home">推荐</button><button bindtap="articles">文章</button><button bindtap="settings">设置</button></view>
