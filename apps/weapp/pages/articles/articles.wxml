<view class="page theme-{{theme}} font-{{font}}"><view class="title">文章</view><picker wx:if="{{categories.length}}" range="{{categories}}" range-key="name" value="{{categoryIndex}}" bindchange="category"><view class="category-picker">分类：{{categories[categoryIndex].name}}</view></picker><input placeholder="搜索文章" value="{{query}}" bindinput="search"/><view class="muted" wx:if="{{state === 'loading'}}">加载中...</view><view class="error" wx:elif="{{state === 'error'}}">{{error}}<button bindtap="retry">重试</button></view><view class="muted" wx:elif="{{state === 'empty'}}">暂无匹配文章</view><block wx:else><view wx:for="{{items}}" wx:key="id" class="item" data-id="{{item.id}}" bindtap="open"><view wx:for="{{item.titleSegments}}" wx:for-item="part" wx:for-index="partIndex" wx:key="partIndex" class="title-part-{{part.match ? 'match' : 'text'}}">{{part.text}}</view><view class="muted">{{item.summary}}</view></view></block></view><view class="nav"><button bindtap="home">推荐</button><button>文章</button><button bindtap="settings">设置</button></view>
