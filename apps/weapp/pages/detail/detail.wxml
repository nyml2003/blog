<view class="page theme-{{theme}} font-{{font}}"><block wx:if="{{state === 'loading'}}"><view class="muted">加载中…</view></block><block wx:elif="{{state === 'error'}}"><view class="error">{{error}}</view><button bindtap="retry">重试</button></block><block wx:else><view class="title">{{article.title}}</view><view class="muted">{{article.summary}}</view><rich-text nodes="{{nodes}}"></rich-text><block wx:if="{{links.length}}"><view class="links-title">正文链接</view><button wx:for="{{links}}" wx:key="*this" data-value="{{index}}" bindtap="openLink">{{item}}</button></block><button bindtap="favorite">{{favorite ? '已收藏' : '收藏'}}</button></block></view>
