{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "desktop",
    "mobile",
    "mobile-ui",
    "common",
    "solid",
    "vite-env.d.ts",
    "vite.config.ts"
  ]
}
