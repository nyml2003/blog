use flake ./nix

nvm_dir="${NVM_DIR:-$HOME/.nvm}"
nvm_default="$(cat "$nvm_dir/alias/default" 2>/dev/null || true)"
nvm_bin="$nvm_dir/versions/node/v${nvm_default#v}/bin"
if [ -n "$nvm_default" ] && [ -x "$nvm_bin/node" ]; then
  nvm_major="$("$nvm_bin/node" -p 'process.versions.node.split(".")[0]')"
  if [ "$nvm_major" -ge 24 ]; then
    PATH_add "$nvm_bin"
  fi
fi
